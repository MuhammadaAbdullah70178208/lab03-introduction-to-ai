   "source": [
    "import numpy as np\n",
    "from PIL import Image\n",
    "\n",
    "def image_to_features(path, size=(64, 64)):\n",
    "    img = Image.open(path).convert(\"RGB\")\n",
    "    img = img.resize(size)\n",
    "    img = img.convert(\"L\")\n",
    "    return np.array(img).flatten()"
   ]
  }
